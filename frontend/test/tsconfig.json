{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // cf. https://vitest.dev/config/#globals
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    }
  },
  "include": ["../**/*.ts", "../**/*.tsx", "../next-env.d.ts"],
  "exclude": ["../node_modules"]
}
